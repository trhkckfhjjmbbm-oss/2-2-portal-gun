-- ========== ФУНКЦИЯ ВХОДА В ИЗМЕРЕНИЕ ==========
_G.BarnyPortal.EnterDimension = function(hrp)
    if _G.BarnyPortal.SavedPos == nil then
        _G.BarnyPortal.SavedPos = hrp.Position
    end
    
    local dim = Dimensions[math.random(1, #Dimensions)]
    local targetPos, dimName = dim()
    
    hrp.CFrame = CFrame.new(targetPos)
    hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "🌌 ИЗМЕРЕНИЕ",
        Text = dimName,
        Duration = 3
    })
    
    if workspace:FindFirstChild("ExitPortal") then workspace.ExitPortal:Destroy() end
    local exitPos = targetPos + Vector3.new(0, 0, 15)
    local exitPortal = CreatePortal(workspace, exitPos, Vector3.new(0, 0, -1), "ExitPortal", _G.BarnyPortal.PortalColor)
    local exitDisc = exitPortal:FindFirstChild("Disc")
    if exitDisc then
        exitDisc.Touched:Connect(function(hit)
            local ch = hit.Parent
            if not ch or ch ~= LP.Character then return end
            local now = os.clock()
            if now - _G.BarnyPortal.LastTP < _G.BarnyPortal.TELEPORT_CD then return end
            _G.BarnyPortal.LastTP = now
            local hrp2 = ch:FindFirstChild("HumanoidRootPart")
            if hrp2 and _G.BarnyPortal.SavedPos then
                hrp2.CFrame = CFrame.new(_G.BarnyPortal.SavedPos)
                hrp2.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            end
        end)
    end
end

